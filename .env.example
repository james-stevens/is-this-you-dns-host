# Copy to .env and edit. Compose reads .env for the ${VAR:-default} substitutions.
# The container speaks plain HTTP and DNS only. TLS is terminated in front of it.

# Public nameservers. Every accepted zone's apex NS, and the parent
# delegation, must include all of these.
SERVICE_NS=ns1.example.net.,ns2.example.net.

# Secondaries that may AXFR, and where NOTIFY is sent.
# IPv4: ip or ip:port. IPv6: [addr] or [addr]:port.
# Use the address the primary observes, not the secondary's loopback.
SECONDARIES=

# DoH JSON resolver. Same query parameters as https://api.web3dns.net/
RESOLVER_BASE_URL=https://api.web3dns.net/

CATALOG_ZONE=catalog.example.net.
CATALOG_RNAME=hostmaster.example.net.

DATA_DIR=/data
HTTP_PORT=8080
DNS_PORT=5353
DNS_BIND=0.0.0.0
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2

# Immediate peers (CIDR or address) allowed to set X-Forwarded-For / X-Forwarded-Proto.
# Leave empty when clients connect directly to this container.
TRUSTED_PROXIES=

# ICANN root DS records shipped in the image. Override to pin your own file.
TRUST_ANCHOR_FILE=/app/deploy/root-anchors.ds

# Optional Handshake root. Both must be set to try that chain when the name
# is proved absent from the ICANN root.
HANDSHAKE_ROOT_SERVERS=
HANDSHAKE_TRUST_ANCHOR_FILE=

# AXFR. Secret is standard base64 (not the raw key). Leave blank to use the
# IP allow-list only. AXFR_REQUIRE_TSIG=true demands a valid TSIG as well.
TSIG_KEY_NAME=
TSIG_SECRET=
TSIG_ALGO=hmac-sha256
AXFR_REQUIRE_TSIG=false

MAX_BODY_BYTES=1048576
MAX_RRSETS=2000
MAX_NAMES=1000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
PARENT_QUERY_BUDGET=15
PARENT_QUERY_WINDOW_SECONDS=60
MAX_DOH_QUERIES_PER_WALK=32
SERIAL_FUTURE_SECONDS=300
SERIAL_PAST_SECONDS=3600
RRSIG_MAX_LIFETIME_SECONDS=2592000
RRSIG_INCEPTION_FUTURE_SECONDS=300
RRSIG_MIN_REMAINING_SECONDS=0
GRACE_DAYS=90
NEGATIVE_CACHE_TTL_SECONDS=60
MIN_TTL=30
MAX_TTL=86400
DS_DIGEST_TYPES=2
APEXES_PER_PARENT_PER_DAY=0
DOH_TIMEOUT_SECONDS=5
DOH_CD=1
MAINTENANCE_INTERVAL_SECONDS=300
HEALTH_CHECK_DNS=true
